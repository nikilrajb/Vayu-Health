# Required for Live mode: OpenAQ v3. Never put this key in frontend variables.
OPENAQ_API_KEY=

# Bounded provider timeouts and transient retries; restart the API after changes.
PROVIDER_CONNECT_TIMEOUT_SECONDS=8
PROVIDER_READ_TIMEOUT_SECONDS=25
PROVIDER_RETRIES=1

# Reserved for future AirNow integration; currently unused.
AIRNOW_API_KEY=

# App
VAYU_HOST=0.0.0.0
VAYU_PORT=8000
DEFAULT_CITY=Delhi
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Meteo weather does not require an API key for non-commercial use.
